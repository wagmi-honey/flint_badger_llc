# Copy to .env for local development. On your host, set these as environment variables.

PORT=3000
SITE_URL=https://flintbadger.site

# Where contact submissions and SMS consent records are saved.
# Option A (Vercel and other serverless hosts): a Postgres connection string. Vercel's Neon integration sets
# POSTGRES_URL for you; DATABASE_URL works too. When set, DATA_DIR is ignored.
DATABASE_URL=
# Option B (servers with a persistent disk): a folder for the JSON Lines file store.
DATA_DIR=./data

# Reverse proxies in front of the app (1 for Render, Railway, Fly, or Nginx; 0 if none).
TRUST_PROXY=1

# Password for https://flintbadger.site/admin/submissions.csv (username: admin). Leave empty to disable.
ADMIN_PASSWORD=

# Email a copy of each inquiry. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Flint Badger Website <contact@flintbadger.site>
NOTIFY_EMAIL=contact@flintbadger.site
